{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arysaikyn/plainquant/model/signals.schema.json",
  "title": "Signals file",
  "description": "The single data contract between model/ and web/. Generated per run and not committed. Decimals are fractions: 0.12 means 12%. Dates use ISO 8601. max_drawdown is zero or negative. 1.1 adds the optional audit block; a 1.0 producer may omit it.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "generated_at",
    "as_of",
    "market",
    "query",
    "rules",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": ["1.0", "1.1"]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "market": {
      "enum": ["cn_a", "hk", "us", "sa"]
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "object",
      "required": ["sharia"],
      "additionalProperties": false,
      "properties": {
        "sharia": {
          "enum": ["off", "compliant_only"]
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symbol", "name", "rank", "score", "factors"],
        "additionalProperties": false,
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "score": {
            "type": "number"
          },
          "factors": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "sector": {
            "type": "string"
          },
          "sharia": {
            "enum": ["compliant", "non_compliant", "unknown"]
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "backtest": {
      "type": "object",
      "required": ["start", "end", "rebalance", "metrics"],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        },
        "rebalance": {
          "enum": ["D", "W", "M", "Q", "A"]
        },
        "metrics": {
          "type": "object",
          "required": ["annual_return", "max_drawdown", "sharpe"],
          "additionalProperties": {
            "type": "number"
          },
          "properties": {
            "annual_return": {
              "type": "number"
            },
            "max_drawdown": {
              "type": "number",
              "maximum": 0
            },
            "sharpe": {
              "type": "number"
            }
          }
        },
        "equity_curve": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["date", "value"],
            "additionalProperties": false,
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "value": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "description": "Checks that do not depend on the ranking. A strategy whose return loads on the size of a move instead of its direction is running a grid, whatever the rules say. Optional so a 1.0 producer stays valid.",
      "additionalProperties": false,
      "properties": {
        "grid": {
          "type": "object",
          "required": ["score", "verdict", "families"],
          "additionalProperties": false,
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "Grid likeness. 0 is a cross-sectional rule set; 100 is an order sheet a grid bot would write."
            },
            "verdict": {
              "enum": ["crossSection", "thin", "gridlike"]
            },
            "families": {
              "type": "array",
              "items": {
                "enum": [
                  "price",
                  "volume",
                  "momentum",
                  "reversal",
                  "volatility",
                  "fundamental",
                  "sharia",
                  "event"
                ]
              },
              "description": "Factor families the rules read. A set, so order is not meaningful."
            },
            "path_exposure": {
              "type": ["number", "null"],
              "minimum": 0,
              "maximum": 1,
              "description": "Share of the run's return that needs |market move| rather than the signed move. Null when there is no equity curve."
            },
            "persistence": {
              "type": ["number", "null"],
              "minimum": -1,
              "maximum": 1,
              "description": "Lag-one autocorrelation of the run's returns at the backtest frequency. Null when there is no equity curve."
            },
            "findings": {
              "type": "array",
              "items": {
                "enum": [
                  "noExitPolicy",
                  "priceOnly",
                  "shortDecay",
                  "volHarvest",
                  "stopHurts",
                  "highTurnover",
                  "concentrated"
                ]
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["rules"],
        "properties": {
          "rules": {
            "properties": {
              "sharia": {
                "const": "compliant_only"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "rows": {
            "items": {
              "required": ["sharia"]
            }
          }
        }
      }
    }
  ]
}
